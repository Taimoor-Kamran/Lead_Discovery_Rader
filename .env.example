# Copy to .env and fill in. Never commit .env.

# --- Application ---
# local | development | ci | staging | production. `APP_ENV` is accepted as an alias.
# The demo fixture source exists only under `local` and `development`.
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
# Used by the api and worker containers; the compose postgres service reads POSTGRES_*.
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar
DATABASE_URL=postgresql+psycopg://radar:radar@postgres:5432/radar

# --- Redis / RQ ---
REDIS_URL=redis://redis:6379/0
JOB_QUEUE_NAME=default
JOB_QUEUE_IS_ASYNC=true
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_SECONDS=2

# --- Auth ---
# Generate with: openssl rand -hex 32
# HS256 needs at least 32 bytes (RFC 7518 3.2). Anything shorter is a warning under
# local/development/ci and a refusal to start under staging/production.
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_COOKIE_NAME=radar_refresh
# Set to false only for local http development.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# --- Google Places API (New) ---
# A key restricted to "Places API (New)" only, from a project with billing enabled.
# Set a budget alert in Google Cloud Billing before running a live search.
GOOGLE_PLACES_API_KEY=
# Which fields to ask for. Widening this is the only way to store more — and it changes
# the billing SKU: phone, website and addressComponents fall into the Enterprise tier.
PLACES_FIELD_MASK=places.id,places.displayName,places.formattedAddress,places.addressComponents,places.location,places.nationalPhoneNumber,places.internationalPhoneNumber,places.websiteUri,places.businessStatus,places.types,places.primaryType,nextPageToken
# Text Search (New) returns at most 20 results a page and 60 in total per query.
PLACES_MAX_RESULTS_PER_JOB=60
# Cost guard: outbound calls per source per UTC day. Exceeding it fails the run.
PLACES_DAILY_CALL_CAP=200
PLACES_RPS=5
# How long Places content may be stored, per the Google Maps Platform terms.
# `make purge-expired` nulls the payload after this; place IDs are kept.
PLACES_CONTENT_TTL_DAYS=30

# --- Entity resolution (v0.3.0) ---
# A record scoring at or above AUTO_MERGE, and holding a strong key (a shared domain, a
# shared phone, or an exact address with a near-identical name), is linked automatically.
# From REVIEW up, and any pair sharing a domain or a phone, goes to a human instead.
RESOLUTION_AUTO_MERGE=0.85
RESOLUTION_REVIEW=0.60
# How much each signal is worth. These add up to 1.0; changing one changes every score,
# so re-check the demo expectations after editing them.
RESOLUTION_WEIGHT_DOMAIN=0.30
RESOLUTION_WEIGHT_PHONE=0.30
RESOLUTION_WEIGHT_NAME=0.20
RESOLUTION_WEIGHT_ADDRESS=0.15
RESOLUTION_WEIGHT_GEO=0.05
# How many existing businesses one record may be compared against, and how alike two
# names must be before sharing a map cell makes them worth comparing at all.
RESOLUTION_MAX_CANDIDATES=25
RESOLUTION_BLOCK_NAME_RATIO=80
# Highest priority first: when two sources disagree about a field, the earlier one wins.
RESOLUTION_SOURCE_PRIORITY=google_places,demo_fixture

# --- Website audit (v0.4.0) ---
# Optional. Enable "PageSpeed Insights API" in the same Google Cloud project and either
# add it to the existing key's API restrictions or create a second key restricted to it.
# Without a key PageSpeed still answers, at a low shared quota. The tests need no key.
PAGESPEED_API_KEY=
# Where a site owner who sees our bot in their logs can reach a human — the agency's site
# or an email address. It goes into the User-Agent: polite crawling identifies itself.
BOT_CONTACT=
# How many audits may be fetching at once, and the hard ceiling on one response body.
AUDIT_MAX_CONCURRENCY=4
AUDIT_MAX_BYTES=2000000
# Per-request timeouts, and the budget for one page including its redirects.
AUDIT_CONNECT_TIMEOUT_SECONDS=5
AUDIT_READ_TIMEOUT_SECONDS=10
AUDIT_TOTAL_TIMEOUT_SECONDS=20
AUDIT_MAX_REDIRECTS=3
# Politeness: seconds between two requests to the same host, and how long a robots.txt
# answer is cached.
AUDIT_HOST_THROTTLE_SECONDS=5
AUDIT_ROBOTS_CACHE_SECONDS=86400
# How long an audit's stored page text may be kept. `make purge-expired` nulls it after
# this; the checks, findings and evidence snippets stay.
AUDIT_CONTENT_TTL_DAYS=90
# A business whose newest audit is older than this is audited again by the pipeline.
AUDIT_MAX_AGE_DAYS=30
# PageSpeed mobile performance below this is reported as `slow_mobile`.
AUDIT_SLOW_MOBILE_SCORE=50
# A copyright year this many years behind the current one is reported as `stale_copyright`.
AUDIT_STALE_COPYRIGHT_YEARS=3
# How much visible page text an audit keeps (input for the v0.5.0 AI step).
AUDIT_PAGE_TEXT_MAX_CHARS=20000
# Cost guards for PageSpeed, shared by every api and worker process.
PSI_RPS=1
PSI_DAILY_CALL_CAP=200
# Industries where booking online is normal, so its absence is worth reporting.
AUDIT_BOOKING_INDUSTRIES=plumbing,hvac,electrical,roofing,general_contracting,locksmith,pest_control,cleaning,landscaping,moving,auto_repair,dental,medical,chiropractic,physiotherapy,veterinary,hair_salon,beauty,spa,fitness,legal,accounting

# --- AI classification (v0.5.0) ---
# openai | fake | disabled. Leave empty to resolve it automatically: `openai` when a key is
# set, `fake` under local/development/ci without one (answers come from app/demo/ai/, no
# network), `disabled` in staging/production without a key (rules only, AI is skipped).
AI_PROVIDER=
# The client's OpenAI key, on the client's billing. Set a MONTHLY SPEND LIMIT in the OpenAI
# dashboard before using it. Only public homepage text and audit results are ever sent.
OPENAI_API_KEY=
# Exact API model names from OpenAI's current model list: a small, cheap one for triage
# and a stronger one for the unclear cases. Copy the names, do not guess them.
AI_TRIAGE_MODEL=
AI_ESCALATION_MODEL=
# Their current prices in USD per million tokens, from the pricing page. Used only for our
# own cost estimate and the daily budget; when left empty costs are recorded as null and
# the daily budget is enforced by AI_DAILY_CALL_CAP alone.
AI_TRIAGE_PRICE_IN_PER_M=
AI_TRIAGE_PRICE_OUT_PER_M=
AI_ESCALATION_PRICE_IN_PER_M=
AI_ESCALATION_PRICE_OUT_PER_M=
# Escalate unclear cases (schema drift, confidence 0.40-0.60, a JavaScript shell, an
# industry that does not match the listing) to the stronger model, once.
AI_ESCALATION_ENABLED=true
# Cost guards, shared by every api and worker process (Redis, UTC day). When a guard
# trips the AI is skipped for the rest of the day/run; rule opportunities are still made.
AI_DAILY_BUDGET_USD=2.00
AI_MAX_CALLS_PER_RUN=200
AI_DAILY_CALL_CAP=500
AI_RPS=2
# How much page text the model sees, and how long a call may take.
AI_PAGE_TEXT_MAX_CHARS=8000
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
# How much of the raw model text is kept (it expires with AUDIT_CONTENT_TTL_DAYS).
AI_RAW_OUTPUT_MAX_CHARS=20000
# `buying_intent = explicit` survives only when a verbatim quote from the page contains one
# of these. Comma-separated, matched case-insensitively. Intent is never guessed.
AI_EXPLICIT_INTENT_PATTERNS=looking for a new website,looking for a web designer,hiring a web designer,need a new website,want a new website,need help with marketing,looking for marketing help,hiring a marketing agency
# Scoring weights (`scoring-1`): facts / inference / intent / contactability. Assumptions
# until calibrated against reviewed opportunities; they add up to 1.0.
SCORING_WEIGHT_FACTS=0.25
SCORING_WEIGHT_INFERENCE=0.45
SCORING_WEIGHT_INTENT=0.10
SCORING_WEIGHT_CONTACTABILITY=0.20

# --- Human review (v0.6.0) ---
# How long after a decision the deciding reviewer (or any admin) may undo it.
REVIEW_UNDO_WINDOW_MINUTES=30
# A business+service rejected, marked not-a-fit or duplicate within this many days is not
# re-created as pending by re-classification. Approved rows are never overwritten.
REVIEW_COOLDOWN_DAYS=90
# The review queue hides opportunities below this confidence unless "Show weak signals"
# is on; a business whose only pending items are weak is hidden with them.
REVIEW_WEAK_CONFIDENCE=0.4

# --- CRM export (v0.7.0) ---
# Where approved leads go once their undo window has closed:
#   csv      — download a file from the CRM page (no account needed; the default)
#   airtable — the client's Airtable base (fill in the AIRTABLE_* values below)
#   fake     — an in-database stand-in for tests and the demo; refused outside
#              local/development/ci. `make e2e` needs this one.
CRM_DESTINATION=csv
# Send automatically from the worker once an approval's undo window has closed. With
# false, leads still queue up as "scheduled" and a CRM manager sends them by hand.
CRM_AUTO_SYNC=true
# Minutes after an approval before it may leave. Empty = REVIEW_UNDO_WINDOW_MINUTES, so an
# approval undone in time never reaches the CRM. Never set it lower than the undo window.
CRM_SYNC_DELAY_MINUTES=
# Transient failures (timeouts, 429, 5xx): how many tries, with 60s, 120s, ... between them,
# before the lead is held for a human. Auth and config errors hold immediately.
CRM_SYNC_MAX_ATTEMPTS=3
CRM_SYNC_BACKOFF_SECONDS=60
# How often the worker looks for due leads.
CRM_SYNC_INTERVAL_SECONDS=60
# Where the web app lives, for the "Radar link" column in the CRM.
APP_BASE_URL=http://localhost:3000
# Airtable (see docs/crm/airtable-setup.md). A personal access token scoped to ONE base with
# data.records:read, data.records:write and schema.bases:read (schema.bases:write only for
# `make crm-bootstrap-airtable`). Never logged; redacted from every error.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
# The table's name or its tbl... id.
AIRTABLE_TABLE=Leads
# Airtable allows 5 requests/second per base; stay under it.
AIRTABLE_RPS=4
AIRTABLE_DAILY_CALL_CAP=5000
# Optional: a copy of backend/app/modules/crm/crm_field_map.airtable.json with your column names.
AIRTABLE_FIELD_MAP=

# --- make seed-demo-users (development only) ---
# One password for reviewer@example.com, rep1@example.com, rep2@example.com and
# crm@example.com. At least 12 characters. The command refuses to run outside
# local/development and with this left empty.
DEMO_USERS_PASSWORD=

# --- make reset-password ---
# Set only for a non-interactive reset (CI, a script). Leave it unset and the command
# prompts twice without echoing, which is the normal way to run it.
# NEW_PASSWORD=

# --- make seed-admin ---
ADMIN_EMAIL=admin@example.com
# Leave empty to have a strong password generated and printed once.
ADMIN_PASSWORD=

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
