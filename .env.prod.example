# Production mode on this machine (spec v0.8.0). Copy to .env.prod and fill in.
# NEVER commit .env.prod, and NEVER reuse the development .env: the startup checks refuse
# a short JWT_SECRET, DEBUG=true, a fake CRM or AI provider, a demo users password, an
# admin address under example.com and a '*' in CORS_ORIGINS.
#
# Back this file up separately from `make backup` (dumps never include it) and keep the
# copy somewhere safe: without JWT_SECRET and the API keys a restored database is not
# enough to bring the system back.

# --- Application ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# The exact origin the browser loads the web app from. No '*'.
CORS_ORIGINS=http://127.0.0.1:3000
APP_BASE_URL=http://127.0.0.1:3000
# Times below (BACKUP_AT, PURGE_AT, the weekly verify) are read in this IANA timezone.
TIMEZONE=UTC

# --- PostgreSQL (not published outside the Docker network in production) ---
POSTGRES_USER=radar
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=radar
# Must carry the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://radar:CHANGE-ME@postgres:5432/radar

# --- Redis / RQ ---
REDIS_URL=redis://redis:6379/0
JOB_QUEUE_NAME=default
JOB_QUEUE_IS_ASYNC=true
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_SECONDS=2

# --- Auth ---
# Generate: openssl rand -hex 32   (at least 32 bytes; rotating it logs everyone out)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_COOKIE_NAME=radar_refresh
# Always Secure in production. Browsers treat 127.0.0.1 and localhost as secure contexts,
# so the cookie works on this machine over plain http.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
# Login protection: 5 failures per email+IP in 15 minutes → 429; 10 per account → locked.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# --- The real administrator (make prod-seed-admin). Not admin@example.com. ---
ADMIN_EMAIL=
# Leave empty to have a strong temporary password generated and printed once.
ADMIN_PASSWORD=

# --- Google Places API (New) — the client's key, restricted to Places API (New) ---
GOOGLE_PLACES_API_KEY=
PLACES_MAX_RESULTS_PER_JOB=60
PLACES_DAILY_CALL_CAP=200
PLACES_RPS=5
PLACES_CONTENT_TTL_DAYS=30
# A listing with fewer reviews than this is reported as `few_reviews`.
PLACES_FEW_REVIEWS=20

# --- Website audit ---
PAGESPEED_API_KEY=
# Where a site owner can reach a human (the agency's site or an email address).
BOT_CONTACT=
PSI_DAILY_CALL_CAP=200
AUDIT_CONTENT_TTL_DAYS=90
# Fewer words of visible homepage text than this is reported as `thin_content`.
AUDIT_THIN_CONTENT_WORDS=200
# A PageSpeed accessibility or best-practices score below this is reported.
AUDIT_QUALITY_SCORE_THRESHOLD=90
# ...and below this it is `medium` severity rather than `low`.
AUDIT_QUALITY_SCORE_MEDIUM_BELOW=70

# --- AI classification: openai (with a key) or disabled. Never fake. ---
# `disabled` is the MVP default: the deterministic rules run on their own, no model is
# called and nothing is spent. It is a supported production configuration in its own right
# (spec v0.10.0 §3) — the startup check allows it explicitly. To turn the model on, set
# AI_PROVIDER=openai, fill in OPENAI_API_KEY and both model names, and set a monthly spend
# limit in the OpenAI dashboard first.
AI_PROVIDER=disabled
OPENAI_API_KEY=
AI_TRIAGE_MODEL=
AI_ESCALATION_MODEL=
AI_TRIAGE_PRICE_IN_PER_M=
AI_TRIAGE_PRICE_OUT_PER_M=
AI_ESCALATION_PRICE_IN_PER_M=
AI_ESCALATION_PRICE_OUT_PER_M=
AI_DAILY_BUDGET_USD=2.00
AI_DAILY_CALL_CAP=500

# --- CRM export: csv or airtable. Never fake. ---
CRM_DESTINATION=csv
CRM_AUTO_SYNC=true
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Leads

# --- Backups and the scheduler (worker) ---
BACKUP_KEEP=14
BACKUP_AT=02:00
BACKUP_VERIFY_CRON=0 4 * * 0
PURGE_AT=03:00
SCHEDULER_ENABLED=true
WATCHDOG_STALE_MINUTES=30
LOG_KEEP_DAYS=14

# --- Alert thresholds (/admin/health) ---
ALERT_JOB_SUCCESS_RATE_MIN=0.80
ALERT_SOURCE_ERROR_RATE_MAX=0.20
ALERT_AI_BUDGET_RATIO=0.80
ALERT_BACKUP_MAX_AGE_HOURS=36
ALERT_QUEUE_LENGTH_MAX=500

# --- Must stay EMPTY in production ---
DEMO_USERS_PASSWORD=

# --- Frontend (inlined at image build time) ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Compose passes ENVIRONMENT here; it decides whether an error says `make prod-ps`.
NEXT_PUBLIC_ENVIRONMENT=production
